{
  "name": "dlsgm",
  "version": "1.0.1-test",
  "main": "dist/main/main/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:renderer": "vite --config src/renderer/vite.config.mts",
    "dev:main": "tsc -w -p tsconfig.main.json",
    "build:main": "tsc -p tsconfig.main.json",
    "dev": "npm run build:main && concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build --config src/renderer/vite.config.mts",
    "start": "npm run build:main && npm run build:renderer && electron .",
    "stop": "pkill electron || taskkill /F /IM electron.exe || echo 'Aucun processus Electron trouvé'",
    "restart": "npm-run-all stop start",
    "build": "npm run build:main && npm run build:renderer && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "build": {
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "src/renderer/dist/**/*",
      "package.json"
    ],
    "appId": "com.dlsgm.app",
    "productName": "DLSGM",
    "publish": {
      "provider": "github",
      "owner": "Matty-H",
      "repo": "DLSGM"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-AutoUpdate.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-AutoUpdate-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^35.0.1",
    "electron-builder": "^26.7.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "cheerio": "^1.2.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "lucide-react": "^1.28.0"
  }
}
